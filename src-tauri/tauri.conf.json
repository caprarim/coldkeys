{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColdKeys",
  "version": "0.1.0",
  "identifier": "com.coldwork.coldkeys",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ColdKeys",
        "width": 900,
        "height": 660,
        "minWidth": 520,
        "minHeight": 460,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "See and manage the keyboard shortcuts that launch your apps",
    "longDescription": "ColdKeys lists every keyboard shortcut that launches an app and lets you add, edit or remove them. On Linux it writes GNOME custom shortcuts. On Windows it registers the shortcuts itself from the tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
